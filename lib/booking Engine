import { supabase } from './supabaseClient';

export async function getAvailableSlots(date) {
  try {
    if (!supabase) return [];
    
    const { data, error } = await supabase
      .from('appointments')
      .select('*');

    if (error) {
      console.log('Supabase error:', error);
      return [];
    }

    return data || [];
  } catch (err) {
    console.log('Execution error:', err);
    return [];
  }
}
